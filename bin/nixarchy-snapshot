#!/bin/bash

COMMAND="$1"
NIXARCHY_PATH=${NIXARCHY_PATH:-$HOME/nixarchy}

if [[ -z $COMMAND ]]; then
  echo "Usage: nixarchy-snapshot <create|restore>" >&2
  exit 1
fi

if ! command -v snapper &>/dev/null; then
  exit 127 # nixarchy-update can use this to just ignore if snapper is not available
fi

case "$COMMAND" in
create)
  DESC="$(nixarchy-version)"

  for config in root home; do
    sudo snapper -c "$config" create -c number -d "$DESC"
  done
  ;;
restore)
  sudo limine-snapper-restore
  ;;
esac
